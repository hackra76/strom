{
  "name": "strom-rodokmen",
  "version": "3.21.1",
  "description": "Dvorský Family Tree - Web Viewer",
  "scripts": {
    "embed": "tsx scripts/embed-tree.ts",
    "sync": "tsx scripts/sync-tree.ts",
    "build": "tsx scripts/embed-tree.ts",
    "build:dev": "esbuild src/main.ts --bundle --sourcemap --outfile=dist/bundle.js",
    "watch": "esbuild src/main.ts --bundle --sourcemap --outfile=dist/bundle.js --watch",
    "dev": "npm run embed && npx http-server -p 8080 -c-1",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo"
  },
  "keywords": [
    "family-tree",
    "genealogy",
    "dvorsky"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}